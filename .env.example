KANTEISHO_ACCESS_PASSWORD=実証用の長いパスワード
SESSION_SECRET=十分に長いランダム文字列
SESSION_HOURS=12
MEMBER_SESSION_HOURS=24

# 会員版をSupabaseへ接続するときに設定します。
# service roleキーはサーバー専用です。HTMLやapp.jsには記載しないでください。
SUPABASE_URL=https://プロジェクトID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=Supabaseのservice_role秘密鍵
PUBLIC_APP_URL=http://localhost:3000

# STORESの4商品とサイト内プランを対応させる商品IDです。
# 2026年8月24日にSTORESの商品編集画面で確認した商品IDです。
# 商品IDは公開商品URLにも含まれる識別子で、API秘密鍵ではありません。
STORES_STARTER_ITEM_ID=6a7db1d62ca89ea7083f4a47
STORES_PREMIUM_ITEM_ID=6a7db23545021ca086e1450b
STORES_STUDENT_ITEM_ID=6a7db2db82a509a1ac820316
STORES_REFERRAL_ITEM_ID=6a7db31e45021cb239e144b2

# 商品をSTORES側で公開・在庫設定した後に、対象商品の販売導線だけをONにします。
# 未設定またはfalseの間は、LPに正式な商品URLを出さず「販売準備中」と表示します。
STORES_STARTER_SALES_ENABLED=false
STORES_PREMIUM_SALES_ENABLED=false
STORES_STUDENT_SALES_ENABLED=false
STORES_REFERRAL_SALES_ENABLED=false
